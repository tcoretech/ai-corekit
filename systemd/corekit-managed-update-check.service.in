[Unit]
Description=AI CoreKit managed service update check
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=@COREKIT_USER@
Group=@COREKIT_GROUP@
UMask=0077
WorkingDirectory=@PROJECT_ROOT@
Environment=COREKIT_PROJECT_ROOT=@PROJECT_ROOT@
Environment=COREKIT_MANAGED_STATE_ROOT=@STATE_ROOT@
Environment=COREKIT_N8N_BACKUP_ROOT=@BACKUP_ROOT@
ExecStart=/usr/bin/flock --nonblock @STATE_ROOT@/systemd-check.lock @PROJECT_ROOT@/corekit.sh managed-update check n8n
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@STATE_ROOT@

[Install]
WantedBy=multi-user.target
