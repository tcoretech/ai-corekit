# Production n8n. Single quotes throughout, as CLAUDE.md requires.
# None of these values are generated by this staging work. The owner creates
# them when applying the design.

N8N_PROD_HOSTNAME='n8n-prod.<yourdomain>.com'

# openssl rand -hex 32   -- and store a copy in the password manager,
# separately from any database backup.
N8N_PROD_ENCRYPTION_KEY=''

# openssl rand -hex 32
N8N_PROD_RUNNER_AUTH_TOKEN=''

# openssl rand -hex 24 -- this database user exists only on the n8n-prod
# Postgres container and has no rights on any other database.
N8N_PROD_DB_NAME='n8n'
N8N_PROD_DB_USER='n8nprod'
N8N_PROD_DB_PASSWORD=''

# Images. This service builds nothing: it adopts an image already built and
# verified for another instance. Required by managed/version.sh, which every
# managed-update subcommand calls.
N8N_PROD_IMAGE=''
N8N_PROD_RUNNER_IMAGE=''

# Promotion. Required by managed/promote.sh. The token needs READ access only:
# the control is the branch protection on the repository, not this token's
# secrecy. Repository may be owner/repo, a full URL, or a local path.
PROMOTION_REPOSITORY=''
PROMOTION_TOKEN=''
PROMOTION_BRANCH='main'
PROMOTION_PATH='workflows'
